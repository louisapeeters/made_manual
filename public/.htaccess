# Combell / Apache shared-hosting config for a Vite + React SPA.
# Lives in /public so Vite copies it verbatim to /dist on `npm run build`.

# 1) Single-Page-App fallback — every non-asset request is rewritten to
#    index.html so React Router can take over (deep links work on refresh).
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Don't rewrite real files (CSS/JS/images) or directories
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Everything else → index.html (HTTP 200, NOT a redirect)
  RewriteRule ^ index.html [L]
</IfModule>

# 2) Long-cache hashed assets — Vite hashes filenames in /assets so they
#    can be cached aggressively. index.html stays no-cache so users
#    always get the latest entry point.
<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|woff2?|ttf|otf|svg|png|jpg|jpeg|gif|webp|avif|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "index\.html$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </FilesMatch>
</IfModule>

# 3) Compress text assets so the page loads fast
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>
